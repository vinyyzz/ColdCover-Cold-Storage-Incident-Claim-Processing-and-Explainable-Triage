# Optional. Run ColdCover commands from this application's root directory.
# Next.js and the database scripts load .env.local; existing process variables win.
# Only a local SQLite file is supported. Relative paths resolve from the working directory.
DATABASE_URL=file:./data/coldcover.db
# For a separate fictional rehearsal, override DATABASE_URL in the command shell
# with an absolute file path, e.g. file:/private/tmp/coldcover-demo/demo.db.
# Reuse the same URL for seed, dev/start and migrations; never point QA at operator data.
# Do not commit runtime database files or .env.local.
# No AI provider/SDK/model/key is configured or required. Anthropic is excluded.
# Do not add provider credentials until a free provider and runtime integration are selected.
